# Copy this file to `.env` (same folder) and fill in your key.
# .env is gitignored â€” your key never gets committed.

# Groq (OpenAI-compatible). Get a key at https://console.groq.com
LLM_API_KEY=your_groq_key_here

# Defaults below work for Groq; change the model if this one is deprecated.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Leave LLM_API_KEY empty to use the offline grader (no network needed).
