# ---- shared ----
ENV=local
# ---- postgres ----
POSTGRES_USER=codesense
POSTGRES_PASSWORD=codesense
POSTGRES_DB=codesense
DATABASE_URL=postgresql://codesense:codesense@db:5432/codesense
# ---- redis ----
REDIS_URL=redis://redis:6379/0
# ---- auth ----
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
# ---- llm (fill when wiring generation/scoring) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ---- service urls (docker network) ----
GENERATION_URL=http://generation:8001
SCORING_URL=http://scoring:8002
PROCTORING_URL=http://proctoring:8003
INTERVIEW_URL=http://interview:8004
