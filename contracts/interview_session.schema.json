{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InterviewSession",
  "type": "object",
  "required": [
    "session_id",
    "candidate_id",
    "company_id",
    "type",
    "domain",
    "level",
    "status"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "practice",
        "live_interview"
      ]
    },
    "proctored": {
      "type": "boolean"
    },
    "domain": {
      "enum": [
        "core_se",
        "web",
        "database",
        "qa",
        "ml"
      ]
    },
    "level": {
      "enum": [
        "associate",
        "engineer",
        "senior"
      ]
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          },
          "ai_prompt": {
            "type": "string"
          },
          "candidate_input": {
            "type": "object"
          },
          "grounding_ref": {
            "type": "string"
          },
          "scoring": {
            "type": "object"
          },
          "adaptive_followup": {
            "type": "object"
          }
        }
      }
    },
    "proctoring": {
      "type": "object",
      "properties": {
        "risk_timeseries": {
          "type": "array"
        },
        "flagged_segments": {
          "type": "array"
        },
        "integrity_confidence": {
          "type": "number"
        }
      }
    },
    "scores": {
      "type": "object"
    },
    "status": {
      "enum": [
        "in_progress",
        "scored",
        "needs_review"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}